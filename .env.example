# Copy this file to ~/.config/voxis/.env.
#
# API key for the OpenAI-compatible LLM endpoint used for ASR term extraction,
# speaker-name mapping, and --polish. BAILIAN_API_KEY is also accepted.
VOXIS_LLM_API_KEY=

# Optional provider overrides. Defaults target Alibaba Bailian/DashScope.
# VOXIS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VOXIS_POLISH_MODEL=deepseek-v4-flash
# VOXIS_SPEAKER_MAP_MODEL=deepseek-v4-flash
# VOXIS_ASR_TERMS_MODEL=qwen-flash

# Comma-separated ASR spelling-hint terms added to every transcription prompt.
# VOXIS_ASR_TERMS=

# Send enable_thinking=false to the LLM endpoint (true/false).
# Default: on for DashScope URLs, off otherwise.
# VOXIS_LLM_DISABLE_THINKING=
